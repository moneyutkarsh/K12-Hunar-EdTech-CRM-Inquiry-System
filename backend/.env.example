# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Supabase PostgreSQL Session Pooler connection string (Port 5432)
# IMPORTANT: Supabase direct connection is IPv6-only. Use the Session Pooler connection string below on Render/Vercel:
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Custom JWT Secret (minimum 32 characters)
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_min_32_chars_k12_hunar_secret

# JWT Expiration
JWT_EXPIRES_IN=8h

# Allowed Client Origin(s) for CORS (comma-separated if multiple, e.g. http://localhost:5173,https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Default Admin Credentials for `npm run seed:admin`
ADMIN_EMAIL=admin@k12hunar.com
ADMIN_PASSWORD=Admin@12345
